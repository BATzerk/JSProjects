# Local migration connection. Never expose this value in browser code.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public Data API and Auth service URLs. These are compiled into the static
# community client; access is controlled by Neon JWTs, grants, and RLS.
NEON_DATA_API_URL=https://your-project.apirest.us-east-1.aws.neon.tech/neondb/rest/v1
NEON_AUTH_BASE_URL=https://your-project.neonauth.us-east-1.aws.neon.tech/neondb/auth
