# Server-only Neon Postgres connection. Never expose this value in browser code.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public Neon Auth endpoint. The app exposes only this URL to the browser.
NEON_AUTH_BASE_URL=https://your-project.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Neon Auth JSON Web Key Set used by the server to verify signed user tokens.
NEON_AUTH_JWKS_URL=https://your-project.neonauth.us-east-1.aws.neon.tech/neondb/auth/jwks
